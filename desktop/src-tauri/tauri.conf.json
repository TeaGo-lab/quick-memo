{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickMemo",
  "version": "0.1.0",
  "identifier": "com.quickmemo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickMemo · 闪念与文件 AI 收纳盒",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
